{
  "name": "otter-arc",
  "version": "1.0.0",
  "description": "ArcPay: Native USDC Micro-Payment & Agentic Gateway on Arc Mainnet",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "cd contracts && forge test",
    "sync-artifact": "node scripts/sync-artifact.mjs",
    "deploy": "cd contracts && forge build && cd .. && npm run sync-artifact && node scripts/deploy.mjs",
    "seed": "node scripts/seed-services.mjs",
    "check-balance": "node scripts/check-balance.mjs",
    "check-links": "node scripts/check-links.mjs",
    "verify": "npm test && npm run check-links",
    "publish-site": "bash scripts/publish-site.sh",
    "verify-deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "viem": "^2.23.0"
  },
  "keywords": [
    "arc",
    "usdc",
    "agentic",
    "circle",
    "microgrants"
  ],
  "author": "OtterArc",
  "license": "MIT"
}
