# ============================================================
# OTTER-ARC / ARCPAY CONFIGURATION
# ============================================================

# 1. Votre clé privée pour déployer sur Arc Mainnet (Chain ID 5042)
# Assurez-vous d'avoir quelques USDC sur votre adresse Arc pour le gas
PRIVATE_KEY=your_private_key_here_without_quotes

# 2. RPC Arc Mainnet officiel
ARC_RPC_URL=https://rpc.mainnet.arc.io

# 3. Adresse de votre wallet pour vérification du solde (optionnel si PRIVATE_KEY est rempli)
WALLET_ADDRESS=
